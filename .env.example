# Telegram Bot Token (Get from @BotFather)
TELEGRAM_TOKEN="your_telegram_bot_token_here"

# Your Google Gemini API Key
GEMINI_API_KEY="your_gemini_api_key_here"

# The Telegram channel username (without @) to monitor
TARGET_CHANNEL="JobSkull"

# (Optional) If you know your chat ID, enter it here.
# If left empty, the bot will automatically capture and lock it on first /start
TELEGRAM_CHAT_ID=""

