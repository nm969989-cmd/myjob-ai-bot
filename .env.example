# ============================================================
# Telegram Job Bot — Environment Contract
# Locally: fill this .env file. On GitHub Actions: these exact
# names must exist as Repository Secrets (Settings → Secrets →
# Actions → New repository secret). The workflow (job_bot.yml)
# maps them into the run step's env: block for cloud_runner.py.
# ============================================================

# --- Core (required) ---
# Telegram Bot Token (Get from @BotFather). cloud_runner also accepts TELEGRAM_BOT_TOKEN as fallback.
TELEGRAM_TOKEN="your_telegram_bot_token_here"

# Your Telegram chat ID (numeric, may be negative for groups).
# If left empty, cloud_runner falls back to chat_id.json committed by the bot on first /start.
TELEGRAM_CHAT_ID=""

# Password for the web dashboard (Flask app on port 7860).
# REQUIRED: if this is empty the dashboard refuses every route and returns 503.
# Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Send it as the X-Admin-Token header, the Authorization: Bearer header,
# or a ?token= query parameter. Anyone holding this value can control the bot.
DASHBOARD_TOKEN=""

# Browser-Use AI applier. Submitting a job application is IRREVERSIBLE, so this
# defaults to dry-run (fills the form, screenshots the review page, never submits).
# Set to 0 to allow real submissions.
BROWSER_USE_DRY_RUN=1

# The Telegram channel username(s) to monitor, comma-separated, without @.
# Merged with cloud_runner's hardcoded priority-channel list each cycle.
TARGET_CHANNEL="JobSkull"

# --- AI Engines ---
# Google Gemini API Key (used by main.py for AI form-filling / QA)
GEMINI_API_KEY="your_gemini_api_key_here"

# Groq API Key (fast LLM fallback used by the optimizer)
GROQ_API_KEY=""
# Model name sent to Groq (workflow defaults to openai/gpt-oss-120b if unset)
GROQ_MODEL="openai/gpt-oss-120b"

# --- Optional Integrations (leave blank to disable the feature) ---
# Notion CRM sync (auto-logged applications)
NOTION_API_KEY=""
NOTION_DATABASE_ID=""

# IMAP resume-email sender (follow-up / rejection reply automation)
BOT_EMAIL=""
BOT_EMAIL_PASSWORD=""

# Adzuna job-board API (extra radar source)
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
